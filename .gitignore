# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Build output (./build.sh)
bin/

# Workflow workspace (runtime-generated by native file tools)
# 前导 / 锚定到仓库根目录，只忽略根目录的运行时数据目录，避免误伤 pkg/workspace/ 源码目录
/workspace/

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
logs/*
logs
frontend/node_modules
.playwright-mcp
.playwright-mcp/*
# 数据库「系统设置」：含本机数据库密码，不进仓库（缺失时回落到 conf.yaml 的 database 块）
config/db_config.json

# 「系统设置」页写入的运行时参数（planner / 单 agent 轮次上限等），
# 属本机运行态数据，缺失时回落到内置默认值，不进仓库
config/agent_settings.json

# 主配置：从 config.example.yaml 复制生成，含真实密码/地址，不进仓库
config/config.yaml

# 临时/草稿目录
.scratch/

# macOS
.DS_Store

# sqlite 模式落地的数据库文件（系统设置可选驱动）
data/*.db
data/*.db-wal
data/*.db-shm
data

# Python 缓存与虚拟环境目录
__pycache__/
.python/
.venv/
venv/

# Windows install.bat 下载的可移植运行时（Go / Node.js / Python）
.tools/

# 用户自定义 skills（本地上传，不进仓库）
skills/user/
# go build 无 -o 时落在仓库根的包二进制（cmd/server、cmd/scheduler、cmd/supervisor）
/server
/scheduler
/agent-server
/agent-scheduler
/agent-supervisor
/supervisor
